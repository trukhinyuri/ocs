{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:2469d359-fc4d-5d46-a619-371eabb038a3",
  "title": "OCS report",
  "type": "object",
  "properties": {
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "host",
        "executor",
        "peer",
        "adapter",
        "mixed"
      ]
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "$ref": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703#/$defs/timestamp"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped",
              "not_applicable"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "rule",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packageVersion": {
      "$ref": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703#/$defs/version"
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "$ref": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703#/$defs/name"
          },
          "version": {
            "$ref": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703#/$defs/version"
          }
        },
        "required": [
          "operation",
          "version"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703#/$defs/feature"
      },
      "uniqueItems": true
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suiteDigest": {
      "$ref": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703#/$defs/digest"
    }
  },
  "required": [
    "edition",
    "suite",
    "target",
    "role",
    "binding",
    "observedAt",
    "scope",
    "checks",
    "limitations",
    "packageVersion",
    "contracts",
    "platform",
    "features",
    "implementations",
    "suiteDigest"
  ],
  "additionalProperties": false
}
