{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:f646f495-f214-5389-8f70-75f3114ee703",
  "title": "OCS common",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 160,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][a-zA-Z0-9-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][a-zA-Z0-9-]*))*)?(?:\\+[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*)?$",
      "maxLength": 128,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[0-9]+\\.[0-9]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "schema": {
      "type": [
        "object",
        "boolean"
      ]
    }
  }
}
