[
  {
    "id": "negotiation",
    "rule": "W-05",
    "steps": [
      {
        "method": "ocs.describe",
        "params": {
          "protocols": [
            "0.1"
          ],
          "requiredFeatures": [],
          "meta": {
            "deadline": "${deadline}"
          }
        },
        "expect": {
          "result": {
            "protocol": "0.1",
            "packageId": "${packageId}",
            "packageVersion": "${packageVersion}",
            "manifestDigest": "${manifestDigest}"
          }
        }
      }
    ]
  },
  {
    "id": "status-read",
    "rule": "W-06",
    "steps": [
      {
        "method": "ocs.describe",
        "params": {
          "protocols": [
            "0.1"
          ],
          "requiredFeatures": [],
          "meta": {
            "deadline": "${deadline}"
          }
        },
        "expect": {
          "result": {
            "protocol": "0.1",
            "packageId": "${packageId}",
            "packageVersion": "${packageVersion}",
            "manifestDigest": "${manifestDigest}"
          }
        }
      },
      {
        "method": "tool.call",
        "params": {
          "operation": "example.status.read",
          "version": "1.0.0",
          "input": {
            "resourceId": "demo"
          },
          "meta": {
            "deadline": "${deadline}",
            "protocol": "0.1",
            "manifestDigest": "${manifestDigest}"
          }
        },
        "expect": {
          "result": {
            "data": {
              "resourceId": "demo",
              "state": "ready"
            }
          }
        }
      }
    ]
  },
