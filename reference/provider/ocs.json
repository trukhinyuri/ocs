      "version": "1.0.0",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "working",
              "needs-auth",
              "denied",
              "exhausted",
              "disabled",
              "unverified",
              "unavailable",
              "unknown"
            ]
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "provider",
          "accounts",
          "count",
          "enabled",
          "working",
          "attention",
          "sharedPools",
          "sharedPoolRemaining",
          "observedAt"
        ]
      }
    },
